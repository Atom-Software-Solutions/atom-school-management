{
  "name": "atom-school-management",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "vercel-build": "npm install && prisma generate && nest build",
    "build": "nest build",
    "postbuild": "node scripts/postbuild-copy-prisma.cjs",
    "dev": "npm run build && npm run start:prod",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_OPTIONS='-r tsconfig-paths/register' nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r tsconfig-paths/register dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:build": "docker build -t atom-school-management:test .",
    "docker:build:no-cache": "docker build --no-cache -t atom-school-management:test .",
    "docker:build:ci": "docker buildx build --platform linux/amd64 --load -t atom-school-management:test .",
    "docker:test": "docker build -t atom-school-management:test . && docker run --rm atom-school-management:test sh -c \"test -f dist/src/main.js && test -d generated/prisma && echo '✅ Build verified'\"",
    "docker:test:ci": "./test-docker-ci.sh",
    "docker:test:unit": "docker build --target build -t atom-school-management:test . && docker run --rm atom-school-management:test npm test",
    "docker:test:e2e": "docker build --target build -t atom-school-management:test . && docker run --rm --network host -e DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atom_school_db_test -e NODE_ENV=test atom-school-management:test npm run test:e2e",
    "docker:test:all": "docker build --target build -t atom-school-management:test . && docker run --rm --network host -e DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atom_school_db_test -e NODE_ENV=test atom-school-management:test sh -c 'npm test && npm run test:e2e'"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsconfig-paths": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@generated/prisma$": "<rootDir>/../generated/prisma",
      "^@generated/(.*)$": "<rootDir>/../generated/$1",
      "^@prisma/client$": "<rootDir>/../generated/prisma"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
