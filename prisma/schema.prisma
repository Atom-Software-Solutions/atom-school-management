generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["payment_mgt", "student_mgt", "user_mgt"]
}

model School {
  id         String        @id @default(uuid())
  name       String
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  address    String?
  code       String        @unique
  currency   String        @default("UGX")
  email      String
  is_active  Boolean       @default(true)
  logo_url   String?
  phone      String
  time_zone  String        @default("Africa/Kampala")
  settings   Json?
  deleted_at DateTime?
  domain     String
  admins     SchoolAdmin[]

  @@index([code])
  @@index([deleted_at])
  @@schema("user_mgt")
}

model User {
  id                     String        @id @default(uuid())
  email                  String        @unique
  phone                  String?       @unique
  password_hash          String
  first_name             String
  last_name              String
  role                   Role
  is_active              Boolean       @default(true)
  last_login             DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt
  email_verified         Boolean       @default(false)
  email_verified_at      DateTime?
  verification_token     String?       @unique
  password_reset_token   String?       @unique
  password_reset_expires DateTime?
  adminOf                SchoolAdmin[]
  sessions               Session[]

  @@index([verification_token])
  @@index([password_reset_token])
  @@schema("user_mgt")
}

model SchoolAdmin {
  id             String   @id @default(uuid())
  school_id      String
  user_id        String
  is_super_admin Boolean  @default(false)
  created_at     DateTime @default(now())
  school         School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([school_id, user_id])
  @@index([school_id])
  @@index([user_id])
  @@schema("user_mgt")
}

model Student {
  id         String            @id @default(uuid())
  school_id  String
  first_name String
  last_name  String
  email      String?           @unique
  phone      String?           @unique
  is_active  Boolean           @default(true)
  deleted_at DateTime?
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
  reg_no     String?
  student_no String
  guardians  StudentGuardian[]

  @@unique([school_id, student_no])
  @@index([school_id])
  @@index([deleted_at])
  @@schema("student_mgt")
}

model Guardian {
  id         String            @id @default(uuid())
  first_name String
  last_name  String
  email      String?
  phone      String?
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
  school_id  String
  students   StudentGuardian[]

  @@index([school_id])
  @@schema("student_mgt")
}

model StudentGuardian {
  id          String   @id @default(uuid())
  student_id  String
  guardian_id String
  relation    String?
  created_at  DateTime @default(now())
  guardian    Guardian @relation(fields: [guardian_id], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, guardian_id])
  @@index([student_id])
  @@index([guardian_id])
  @@schema("student_mgt")
}

model Session {
  id         String    @id @default(uuid())
  user_id    String
  jti        String    @unique
  is_active  Boolean   @default(true)
  ip_address String?
  user_agent String?
  created_at DateTime  @default(now())
  expires_at DateTime
  revoked_at DateTime?
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@schema("user_mgt")
}

model Payment {
  id             String               @id @default(uuid())
  user_id        String
  amount         Decimal              @db.Decimal(10, 2)
  currency       String               @default("UGX")
  status         String
  payment_method String
  reference      String               @unique
  description    String?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  completed_at   DateTime?
  school_id      String?
  transactions   PaymentTransaction[]

  @@index([user_id])
  @@index([school_id])
  @@index([status])
  @@index([reference])
  @@schema("payment_mgt")
}

model PaymentTransaction {
  id         String   @id @default(uuid())
  payment_id String
  amount     Decimal  @db.Decimal(10, 2)
  type       String
  status     String
  reference  String   @unique
  metadata   Json?
  created_at DateTime @default(now())
  payment    Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([status])
  @@index([reference])
  @@schema("payment_mgt")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PARENT
  STUDENT

  @@schema("user_mgt")
}
