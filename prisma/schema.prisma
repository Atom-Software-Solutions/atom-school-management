generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["payment_mgt", "student_mgt", "user_mgt", "results_mgt"]
}

model School {
  id         String        @id @default(uuid())
  name       String
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  address    String?
  code       String        @unique
  currency   String        @default("UGX")
  email      String
  is_active  Boolean       @default(true)
  logo_url   String?
  phone      String
  time_zone  String        @default("Africa/Kampala")
  settings   Json?
  deleted_at DateTime?
  domain     String
  motto      String?
  admins     SchoolAdmin[]
  reportCards ReportCard[]

  @@index([code])
  @@index([deleted_at])
  @@schema("user_mgt")
}

model User {
  id                     String        @id @default(uuid())
  email                  String        @unique
  phone                  String?       @unique
  password_hash          String
  first_name             String
  last_name              String
  role                   Role
  is_active              Boolean       @default(true)
  last_login             DateTime?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt
  email_verified         Boolean       @default(false)
  email_verified_at      DateTime?
  verification_token     String?       @unique
  password_reset_token   String?       @unique
  password_reset_expires DateTime?
  adminOf                SchoolAdmin[]
  sessions               Session[]

  @@index([verification_token])
  @@index([password_reset_token])
  @@schema("user_mgt")
}

model SchoolAdmin {
  id             String   @id @default(uuid())
  school_id      String
  user_id        String
  is_super_admin Boolean  @default(false)
  created_at     DateTime @default(now())
  school         School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([school_id, user_id])
  @@index([school_id])
  @@index([user_id])
  @@schema("user_mgt")
}

model Student {
  id            String              @id @default(uuid())
  school_id     String
  first_name    String
  last_name     String
  email         String?             @unique
  phone         String?             @unique
  gender        String?
  status        String?
  date_of_birth DateTime
  religion      String?
  address       String?
  avatar_url    String?
  is_active     Boolean             @default(true)
  deleted_at    DateTime?
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt
  reg_no        String?
  student_no    String
  guardians     StudentGuardian[]
  enrollments   StudentEnrollment[]
  grades        Grade[]
  reportCards   ReportCard[]
  guardianMessages GuardianMessage[]

  @@unique([school_id, first_name, last_name, date_of_birth])
  @@unique([school_id, student_no])
  @@index([school_id])
  @@index([deleted_at])
  @@schema("student_mgt")
}

model Guardian {
  id         String            @id @default(uuid())
  first_name String
  last_name  String
  email      String?           @unique
  phone      String?           @unique
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
  school_id  String
  students   StudentGuardian[]
  messages   GuardianMessage[]

  @@index([school_id])
  @@schema("student_mgt")
}

model StudentGuardian {
  id          String   @id @default(uuid())
  student_id  String
  guardian_id String
  relation    String?
  created_at  DateTime @default(now())
  guardian    Guardian @relation(fields: [guardian_id], references: [id], onDelete: Cascade)
  student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, guardian_id])
  @@index([student_id])
  @@index([guardian_id])
  @@schema("student_mgt")
}

// NEW: Messaging model for guardian notifications/messages
model GuardianMessage {
  id           String    @id @default(uuid())
  school_id    String
  guardian_id  String
  student_id   String?   // Optional: message may relate to a specific student
  type         String    // "SMS", "Email", "WhatsApp"
  category     String?   // "academic", "fee", "general", etc.
  subject      String?
  message      String
  status       String    @default("pending") // "sent", "failed", "pending"
  sent_at      DateTime?
  metadata     Json?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  guardian     Guardian  @relation(fields: [guardian_id], references: [id], onDelete: Cascade)
  student      Student?  @relation(fields: [student_id], references: [id], onDelete: SetNull)
  
  @@index([school_id])
  @@index([guardian_id])
  @@index([student_id])
  @@index([status])
  @@index([type])
  @@schema("student_mgt")
}

// ==========================================
// ACADEMIC RESULTS MODELS
// ==========================================

model TermTemplate {
  id                String            @id @default(uuid())
  school_id         String
  name              String
  is_locked         Boolean           @default(false)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  academic_years    AcademicYear[]
  term_template_items TermTemplateItem[]

  @@unique([school_id, name])
  @@index([school_id])
  @@index([is_locked])
  @@schema("results_mgt")
}

model TermTemplateItem {
  id               String   @id @default(uuid())
  term_template_id String
  ordinal          Int
  name             String
  start_date       DateTime?
  end_date         DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  term_template TermTemplate @relation(fields: [term_template_id], references: [id], onDelete: Cascade)
  assessments    Assessment[]
  report_cards   ReportCard[]

  @@unique([term_template_id, ordinal])
  @@index([term_template_id])
  @@index([name])
  @@schema("results_mgt")
}

model AcademicYear {
  id               String   @id @default(uuid())
  school_id        String
  name             String
  start_date       DateTime
  end_date         DateTime
  status           String   @default("planned")
  term_template_id String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  term_template TermTemplate        @relation(fields: [term_template_id], references: [id], onDelete: Restrict)
  enrollments   StudentEnrollment[]
  assessments   Assessment[]

  @@unique([school_id, name])
  @@index([school_id])
  @@index([start_date])
  @@index([end_date])
  @@index([term_template_id])
  @@schema("results_mgt")
}

// NOTE: `Term` model removed — per-year terms are derived from the `TermTemplate.structure`.

// ==========================================
// CLASSROOMS & ENROLLMENTS MODELS
// ==========================================

model ClassroomDefinition {
  id          String   @id @default(uuid())
  school_id   String
  name        String
  level       String?
  ordinal     Int      @default(0)
  is_archived Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  enrollments StudentEnrollment[]
  assessments Assessment[]

  @@unique([school_id, name])
  @@index([school_id])
  @@index([is_archived])
  @@index([ordinal])
  @@schema("results_mgt")
}

model StudentEnrollment {
  id                      String    @id @default(uuid())
  student_id              String
  classroom_definition_id String
  academic_year_id        String
  start_date              DateTime  @default(now())
  end_date                DateTime?
  status                  String    @default("active")
  type                    String? // promotion|retention|direct
  reason                  String?
  deleted_at              DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  classroom_definition ClassroomDefinition @relation(fields: [classroom_definition_id], references: [id], onDelete: Restrict)
  academic_year        AcademicYear        @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  student              Student             @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([academic_year_id])
  @@index([classroom_definition_id])
  @@index([status])
  @@schema("results_mgt")
}

model Subject {
  id          String       @id @default(uuid())
  school_id   String
  name        String
  code        String? // Subject code (e.g., "MATH", "ENG")
  description String?
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  assessments Assessment[]
  grades      Grade[]

  @@unique([school_id, name])
  @@index([school_id])
  @@index([is_active])
  @@schema("results_mgt")
}

model Assessment {
  id                      String    @id @default(uuid())
  school_id               String
  academic_year_id        String // Reference to AcademicYear
  term_template_item_id   String // Reference to TermTemplateItem (replaces term_name)
  classroom_definition_id String // Reference to ClassroomDefinition (required)
  subject_id              String
  name                    String // e.g., "Mid-Term Exam", "Assignment 1"
  type                    String // "exam", "test", "assignment", "project", "quiz"
  max_score               Decimal   @db.Decimal(5, 2) // Maximum possible score
  weight                  Decimal   @db.Decimal(5, 2) // Weight for grade calculation (e.g., 0.3 for 30%)
  assessment_date         DateTime?
  due_date                DateTime?
  is_published            Boolean   @default(false) // Whether results are published to students/parents
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  academic_year        AcademicYear        @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  subject              Subject             @relation(fields: [subject_id], references: [id], onDelete: Restrict)
  classroom_definition ClassroomDefinition @relation(fields: [classroom_definition_id], references: [id], onDelete: Restrict)
  term_template_item   TermTemplateItem    @relation(fields: [term_template_item_id], references: [id], onDelete: Restrict)
  grades               Grade[]

  @@index([school_id])
  @@index([academic_year_id])
  @@index([term_template_item_id])
  @@index([classroom_definition_id])
  @@index([subject_id])
  @@index([is_published])
  @@schema("results_mgt")
}

model Grade {
  id            String     @id @default(uuid())
  school_id     String
  student_id    String
  assessment_id String
  subject_id    String
  score         Decimal    @db.Decimal(5, 2)
  percentage    Decimal?   @db.Decimal(5, 2)
  letter_grade  String?
  remarks       String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  created_by    String?
  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  subject       Subject    @relation(fields: [subject_id], references: [id], onDelete: Restrict)
  student       Student    @relation(fields: [student_id], references: [id], onDelete: Restrict)

  @@unique([student_id, assessment_id])
  @@index([school_id])
  @@index([student_id])
  @@index([assessment_id])
  @@index([subject_id])
  @@schema("results_mgt")
}

model ReportCard {
  id               String    @id @default(uuid())
  school_id        String
  student_id       String
  academic_year_id String // Reference to AcademicYear
  term_template_item_id String // Reference to TermTemplateItem (replaces term_name)
  overall_average  Decimal?  @db.Decimal(5, 2)
  total_subjects   Int?
  rank             Int? // Class rank (optional)
  total_students   Int? // Total students in class (for rank context)
  remarks          String? // Teacher/Principal remarks
  status           String    @default("draft") // "draft", "published", "archived"
  generated_at     DateTime  @default(now())
  published_at     DateTime?
  generated_by     String? // User ID who generated the report
  pdf_url          String? // URL to generated PDF file

  term_template_item TermTemplateItem @relation(fields: [term_template_item_id], references: [id], onDelete: Restrict)
  student           Student          @relation(fields: [student_id], references: [id], onDelete: Restrict)
  school            School           @relation(fields: [school_id], references: [id], onDelete: Restrict)

  @@index([school_id])
  @@index([student_id])
  @@index([academic_year_id])
  @@index([term_template_item_id])
  @@index([status])
  @@schema("results_mgt")
}

model Session {
  id         String    @id @default(uuid())
  user_id    String
  jti        String    @unique
  is_active  Boolean   @default(true)
  ip_address String?
  user_agent String?
  created_at DateTime  @default(now())
  expires_at DateTime
  revoked_at DateTime?
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@schema("user_mgt")
}

model Payment {
  id             String               @id @default(uuid())
  user_id        String
  amount         Decimal              @db.Decimal(10, 2)
  currency       String               @default("UGX")
  status         String
  payment_method String
  reference      String               @unique
  description    String?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  completed_at   DateTime?
  school_id      String?
  transactions   PaymentTransaction[]

  @@index([user_id])
  @@index([school_id])
  @@index([status])
  @@index([reference])
  @@schema("payment_mgt")
}

model PaymentTransaction {
  id         String   @id @default(uuid())
  payment_id String
  amount     Decimal  @db.Decimal(10, 2)
  type       String
  status     String
  reference  String   @unique
  metadata   Json?
  created_at DateTime @default(now())
  payment    Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([status])
  @@index([reference])
  @@schema("payment_mgt")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PARENT
  STUDENT

  @@schema("user_mgt")
}
